# Points the contact form at your backend (see your existing /server setup)
VITE_CONTACT_API_URL=http://localhost:5000/api/contact

# Points "Ask Anything" at your backend proxy — NEVER put an Anthropic/OpenAI
# key directly in a VITE_ variable, it gets bundled into the public JS.
# See /server/ask.example.js for the proxy that keeps the real key safe.
VITE_ASK_API_URL=http://localhost:5000/api/ask
